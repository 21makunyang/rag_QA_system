# ─────────────────────────────────────────────────────────────────────────────
# CS6493 RAG System – Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is listed in .gitignore and will NOT be committed.
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key (required for Ragas evaluation and OpenRouter RAG backend)
# Obtain a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Ollama server URL (optional – only needed when using mistral-7b / llama2-7b)
# Default: http://localhost:11434
# OLLAMA_API_BASE=http://localhost:11434

# Logging verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO
